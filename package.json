{
  "name": "agent-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "CLOUDFLARE_ENV=react-preview vite --config vite.react.config.ts",
    "build": "CLOUDFLARE_ENV=react-preview vite build --config vite.react.config.ts",
    "check": "tsc --project tsconfig.react.json --noEmit",
    "preview": "CLOUDFLARE_ENV=react-preview vite preview --config vite.react.config.ts",
    "configure": "node scripts/configure-blog.mjs",
    "test": "vitest run",
    "test:themes": "node scripts/verify-themes.mjs",
    "test:watch": "vitest",
    "review": "node scripts/review.mjs",
    "review:manual": "node scripts/review.mjs manual",
    "review:fixture": "node scripts/review.mjs fixture --fixture test/fixtures/gateway-day.json --draft test/fixtures/review-draft.json --dry-run",
    "deploy": "node scripts/deploy-cloudflare.mjs",
    "deploy:check": "node scripts/deploy-cloudflare.mjs --dry-run",
    "episode:publish": "node scripts/publish-episode.mjs",
    "check:rss": "python3 scripts/check-rss.py",
    "review:submit": "node scripts/submit-review.mjs",
    "content:migrate": "node scripts/migrate-content.mjs",
    "react:dev": "CLOUDFLARE_ENV=react-preview vite --config vite.react.config.ts",
    "react:build": "CLOUDFLARE_ENV=react-preview vite build --config vite.react.config.ts",
    "react:preview": "CLOUDFLARE_ENV=react-preview vite preview --config vite.react.config.ts",
    "react:check": "tsc --project tsconfig.react.json --noEmit",
    "react:db:migrate": "wrangler d1 migrations apply CONTENT --local --config wrangler.react.jsonc --env react-preview",
    "react:db:seed": "node scripts/seed-react-preview.mjs",
    "build:production": "REACT_WRANGLER_CONFIG=wrangler.jsonc vite build --config vite.react.config.ts",
    "test:runtime": "node scripts/verify-react-runtime.mjs",
    "test:browser": "node test/public-player-browser.mjs",
    "check:ui": "node scripts/verify-live-ui.mjs"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.50.0",
    "marked": "^18.0.14",
    "motion": "^13.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.18.0",
    "tailwind-merge": "3.7.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.4",
    "@cloudflare/workers-types": "^5.20261002.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.146.0"
  },
  "engines": {
    "node": ">=24"
  }
}
