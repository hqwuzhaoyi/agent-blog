---
import { siteConfig } from "@/site.config";
const labels = siteConfig.player;
---
<aside id="listening-player" class="listening-player" hidden aria-label={labels.label} transition:persist="listening-player" transition:name="listening-player" transition:animate="none" data-mode="expanded" data-play-label={labels.play} data-pause-label={labels.pause} data-intro-label={labels.intro} data-error-label={labels.error} data-mute-label={labels.mute} data-unmute-label={labels.unmute} data-collapse-label={labels.collapse} data-expand-label={labels.expand}>
  <audio id="episode-audio" preload="metadata"></audio>
  <div class="player-surface">
  <div class="player-art" aria-hidden="true">
    <svg viewBox="0 0 48 48" fill="none"><path d="M12 17h22v12a10 10 0 0 1-10 10h-2a10 10 0 0 1-10-10V17Z" stroke="currentColor" stroke-width="2"/><path d="M34 20h3a5 5 0 0 1 0 10h-3M18 7v5m7-7v7m7-5v5M10 42h27" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  </div>
  <div class="player-body">
    <div class="player-topline">
      <div class="player-copy"><a class="player-title" href="#"></a><span class="player-chapter" aria-live="polite"></span></div>
      <div class="player-actions">
        <button type="button" class="player-skip" data-skip="-10" aria-label={labels.rewind}>−10</button>
        <button type="button" class="player-toggle" aria-label={labels.play}>
          <svg class="player-play-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 11 7-11 7V5Z" fill="currentColor"/></svg>
          <svg class="player-pause-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h4v14H7zm7 0h4v14h-4z" fill="currentColor"/></svg>
        </button>
        <button type="button" class="player-skip" data-skip="10" aria-label={labels.forward}>+10</button>
        <button type="button" class="player-mute" aria-label={labels.mute} aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M4 9h4l5-4v14l-5-4H4V9Z"/><path class="player-volume-wave" d="M17 8a6 6 0 0 1 0 8"/><path class="player-volume-off" d="m17 9 5 6m0-6-5 6"/></svg></button>
        <button type="button" class="player-mode-toggle" aria-label={labels.collapse} aria-expanded="true"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></button>
        <button type="button" class="player-dismiss" aria-label={labels.close}>×</button>
      </div>
    </div>
    <div class="player-timeline">
      <time class="player-elapsed">00:00</time>
      <div class="player-range-track"><span class="player-range-fill" aria-hidden="true"></span><input class="player-range" type="range" min="0" max="1" value="0" step="0.1" aria-label={labels.seek} /></div>
      <time class="player-duration">00:00</time>
    </div>
    <p class="player-error" role="status" hidden></p>
  </div>
  </div>
</aside>
