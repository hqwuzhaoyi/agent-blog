---
import { ClientRouter } from "astro:transitions";
import ListeningPlayer from "@/components/ListeningPlayer.astro";
import { activeTheme, siteConfig } from "@/site.config";
import { sitePath } from "@/lib/paths";
import type { FooterProps, HeaderProps } from "@/themes/shared/contracts";

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
  noindex?: boolean;
  footerText?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  pageClass = "",
  noindex = false,
  footerText = siteConfig.footer.disclaimer,
} = Astro.props;
const pageTitle = title === siteConfig.title ? title : `${title} — ${siteConfig.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ThemeHeader = activeTheme.slots.Header;
const ThemeFooter = activeTheme.slots.Footer;
const currentPath = Astro.url.pathname;
const headerProps: HeaderProps = {
  title: siteConfig.title,
  eyebrow: siteConfig.eyebrow,
  homeUrl: sitePath(),
  navigationLabel: siteConfig.nav.label,
  navigation: [
    { label: siteConfig.nav.latest, url: sitePath(), current: currentPath === sitePath() || currentPath.startsWith(sitePath("reviews/")) },
    { label: siteConfig.nav.episodes, url: sitePath("episodes/"), current: currentPath.startsWith(sitePath("episodes/")) },
    { label: siteConfig.nav.archive, url: sitePath("archive/"), current: currentPath.startsWith(sitePath("archive/")) },
    { label: siteConfig.nav.rss, url: sitePath("rss.xml") },
  ],
};
const footerProps: FooterProps = {
  disclaimer: footerText,
};
---

<!doctype html>
<html lang={siteConfig.language} data-theme={siteConfig.theme}>
  <head>
    <meta charset="UTF-8" />
    <ClientRouter fallback="swap" />
    <meta name="viewport" content="width=device-width" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content={activeTheme.themeColor} />
    <link rel="stylesheet" href={activeTheme.stylesheet} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={sitePath("favicon.svg")} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.title} RSS`} href={sitePath("rss.xml")} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <title>{pageTitle}</title>
  </head>
  <body class={pageClass}>
    <div class="page-shell">
      <ThemeHeader {...headerProps} />
      <main>
        <div class="page-content"><slot /></div>
      </main>
      <ThemeFooter {...footerProps} />
    </div>
    <ListeningPlayer />
    <script>
      import { initListeningPlayer } from "@/scripts/listening-player";
      import { initSiteMotion } from "@/scripts/site-motion";
      initListeningPlayer();
      initSiteMotion();
    </script>
  </body>
</html>
