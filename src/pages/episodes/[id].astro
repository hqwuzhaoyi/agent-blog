---
import { render } from "astro:content";
import { publishedEntry } from "@/lib/content-store";
import { renderMarkdown } from "@/lib/markdown";
import MarkdownContent from "@/components/MarkdownContent.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getEpisodes, presentEpisode } from "@/lib/episodes";
import { sitePath } from "@/lib/paths";
import { activeTheme, siteConfig } from "@/site.config";
export async function getStaticPaths() {
  return (await getEpisodes(import.meta.env.DEV)).map((episode) => ({ params: { id: episode.id }, props: { episode } }));
}
const episode = Astro.locals.contentDB
  ? await publishedEntry<"episodes">(Astro.locals.contentDB, "episode", Astro.params.id!)
  : Astro.props.episode;
if (!episode) return new Response("Not found", { status: 404 });
const Content = Astro.locals.contentDB ? MarkdownContent : (await render(episode)).Content;
const contentProps = Astro.locals.contentDB ? { html: renderMarkdown(episode.body ?? "") } : {};
const EpisodeArticle = activeTheme.slots.EpisodeArticle;
---
<BaseLayout title={episode.data.title} description={episode.data.summary} footerText={siteConfig.episodes.footer} pageClass="episode-page" noindex={episode.data.draft}>
  <EpisodeArticle episode={presentEpisode(episode, siteConfig.locale)} Content={Content} contentProps={contentProps} labels={{ ...siteConfig.episodes, start: siteConfig.player.start }} archiveUrl={sitePath("episodes/")} feedUrl={sitePath("episodes/rss.xml")} />
</BaseLayout>
