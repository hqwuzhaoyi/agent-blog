---
import type { EpisodeArticleProps } from "../contracts";
interface Props extends EpisodeArticleProps {}
const { episode, Content, labels, archiveUrl, feedUrl } = Astro.props;
---
<article class="coffee-article">
  <header class="coffee-article-header">
    <a class="coffee-back" href={archiveUrl}>← {labels.back}</a>
    <div class="coffee-meta"><span>{labels.title}</span><time datetime={episode.dateTime} transition:name={`episode-date-${episode.id}`} transition:animate="initial">{episode.displayDate}</time><span>{episode.displayDuration}</span>{episode.draft && <span>{labels.draft}</span>}</div>
    <h1 transition:name={`episode-title-${episode.id}`} transition:animate="initial">{episode.title}</h1>
    <p class="coffee-description">{episode.summary}</p>
  </header>
  <section id="listen" class="coffee-player" aria-label={episode.title}>
    <div class="coffee-player-slot" data-player-slot={episode.id}>
      <button type="button" class="player-start" data-play-episode>{labels.start} <span aria-hidden="true">▶</span></button>
      <noscript><audio controls preload="metadata" src={episode.audio.url}><a href={episode.audio.url}>{labels.download}</a></audio><style>.player-start{display:none}.coffee-player-slot{min-height:0}</style></noscript>
    </div>
    <div class="coffee-player-links"><a href={feedUrl}>{labels.subscribe} <span aria-hidden="true">↗</span></a></div>
    <p class="coffee-disclosure">{labels.disclosure}</p>
  </section>
  <section class="coffee-chapters" aria-labelledby="chapters-heading">
    <h2 id="chapters-heading">{labels.chapters}</h2>
    <ol><li class="coffee-chapter-marker" aria-hidden="true"></li>{episode.chapters.map((chapter) => (
      <li id={chapter.id}><a href={`#${chapter.id}`} data-start={chapter.start}><span class="coffee-chapter-time">{chapter.timestamp}</span><span class="coffee-chapter-title">{chapter.title}</span><span class="coffee-chapter-indicator" aria-hidden="true">▶</span><span class="coffee-chapter-progress" aria-hidden="true"></span></a></li>
    ))}</ol>
  </section>
  <div class="coffee-notes"><Content /></div>
</article>
<script is:inline type="application/json" id="listening-episode" set:html={JSON.stringify({ id: episode.id, title: episode.title, url: episode.url, audio: episode.audio, duration: episode.duration, chapters: episode.chapters }).replace(/</g, "\\u003c")} />
