---
import type { HeaderProps } from "../contracts";

interface Props extends HeaderProps {}

const { title, eyebrow, homeUrl, navigationLabel, navigation } = Astro.props;
---

<header class="site-header" transition:name="site-header" transition:animate="none">
  <a class="wordmark" href={homeUrl} aria-label={title}>
    <span class="wordmark__signal" aria-hidden="true"></span>
    <span>
      <strong>{title}</strong>
      <small>{eyebrow}</small>
    </span>
  </a>
  <nav class="site-nav" aria-label={navigationLabel}>
    <span class="nav-indicator" aria-hidden="true" transition:persist="nav-indicator"></span>
    {navigation.map((item) => <a href={item.url} aria-current={item.current ? "page" : undefined} data-astro-reload={item.url.endsWith("rss.xml") || undefined}>{item.label}</a>)}
  </nav>
</header>
