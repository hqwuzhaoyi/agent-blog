{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agent-blog",
  "account_id": "9e8eed72f9485f3a8206fc3d6cda605f",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "assets": {
    "directory": "./.cloudflare-assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/agent-blog/audio/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "agent-blog-audio"
    }
  ],
  "routes": [
    {
      "pattern": "blog.wuzhaoyi.xyz",
      "custom_domain": true
    }
  ]
}
